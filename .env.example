# InternBoot M7 environment configuration
APP_ENV=development

# Explicit application DB settings (these override Railway variables when supplied)
DB_HOST=okaido.proxy.rlwy.net
DB_PORT=18068
DB_USER=root
DB_PASSWORD=PASTE_RAILWAY_MYSQL_ROOT_PASSWORD_HERE
DB_NAME=railway

# Railway MySQL variables supplied by the project
MYSQL_DATABASE=railway
MYSQL_PUBLIC_URL=mysql://root:PASTE_RAILWAY_MYSQL_ROOT_PASSWORD_HERE@okaido.proxy.rlwy.net:18068/railway
MYSQL_ROOT_PASSWORD=PASTE_RAILWAY_MYSQL_ROOT_PASSWORD_HERE
MYSQL_URL=mysql://root:PASTE_RAILWAY_MYSQL_ROOT_PASSWORD_HERE@mysql.railway.internal:3306/railway
MYSQLDATABASE=railway
MYSQLHOST=mysql.railway.internal
MYSQLPASSWORD=PASTE_RAILWAY_MYSQL_ROOT_PASSWORD_HERE
MYSQLPORT=3306
MYSQLUSER=root

# ============================================================================
# DEV/DEMO ONLY — do not enable in production
# ============================================================================
# Demo/test mode — bypasses candidate authentication and real payment flows for local development ONLY.
# MUST be 0 (or unset) in production. Setting it to 1 without M4_DEMO_SECRET is ignored securely, 
# but providing a valid M4_DEMO_SECRET allows demo flows.
M4_DEMO_MODE=0
M4_DEMO_SECRET=your_demo_secret_here
# ============================================================================
# SMTP Mail Configuration (M3 Auth OTP Email Pipeline)
# Replace placeholder values with real SMTP credentials (e.g. Mailtrap, SendGrid,
# AWS SES, or Gmail SMTP) before registration verification email sending will work.
# ============================================================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@internboot.com
MAIL_FROM_NAME="InternBoot"

# ============================================================================
# Payment Gateway Configuration (M4 Payment Integration - Easebuzz / PayU)
# ============================================================================
KEY=your_merchant_key
SALT=your_merchant_salt

# ============================================================================
# AI Provider Configuration (M1 AI Question Bank Generation)
# ============================================================================
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# First-Time Database Seed (scripts/seed.php)
# Run once after applying the schema to bootstrap an admin account,
# an active assessment, and an initial question bank.
#   php scripts/seed.php
# Safe to re-run — all steps are idempotent (skipped if data already exists).
# ============================================================================
SEED_ADMIN_EMAIL=admin@internboot.com
SEED_ADMIN_PASSWORD=ChangeMe_AtLeast8Chars!
SEED_ADMIN_NAME=Platform Admin

# Optional — defaults shown below are used when unset
# SEED_ASSESSMENT_TITLE=InternBoot Level Assessment
# SEED_ASSESSMENT_DURATION=60
# SEED_ASSESSMENT_QUESTIONS=50
# SEED_QBANK_NAME=Main Question Bank
